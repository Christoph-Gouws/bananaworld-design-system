{
  "name": "@bananaworld/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Bananaworld design system + shared pure logic used by both Bananaworld-DC and Bananaworld-CRM. The UI barrel ('.') is the 28 pure UI primitives + per-surface (data-surface) tokens — pure presentation only: no network, no permission/scope logic (TECH-COMP-003 / ADR-001). A separate './pricing' subpath ships THE single shared price-calculation engine (pure, no IO — CRM ADR-007 / PRD-FUNC-060) so a quote and the eventual order price identically; it never imports the UI layer. Shipped as TypeScript source; consumers transpile it via Next.js transpilePackages.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pricing": {
      "types": "./src/pricing/index.ts",
      "default": "./src/pricing/index.ts"
    },
    "./sales-order": {
      "types": "./src/sales-order/index.ts",
      "default": "./src/sales-order/index.ts"
    },
    "./tokens.css": "./src/lib/tokens.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
